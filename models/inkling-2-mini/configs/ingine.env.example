# Production serving config for Inkling-2-Mini (abliterated) on RTX 5090 (400 W cap)
# Drop into ~/.config/ingine/env (adjust HOST/PORT for your network)

HOST=127.0.0.1
PORT=8003
INGINE_CTX=262144

# The lossless chunk-6144 / kAttnMaxTiles-112 win is compiled into ingine-serve
# via models/inkling-2-mini/patches/0001-prefill-accept-prefill_chunk-6144-kAttnMaxTiles-112-.patch.
#
# Lossy prefill flags (patches 0002 + 0003) MUST remain OFF in production:
#   INGINE_PREFILL_FP4_MOE=0   # +47% prefill, but failed role-bench quality gate (builder 66.7% -> 33.3%)
#   INGINE_PREFILL_FP8_DENSE=0 # +5% prefill, -3.8% c1 bench decode drift
