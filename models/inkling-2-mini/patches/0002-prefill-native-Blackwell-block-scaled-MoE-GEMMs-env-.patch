 #include <cuda_bf16.h>
 #include <cuda_fp16.h>
+#include <cuda_fp4.h>
 #include <cuda_fp8.h>
 #include <cuda_runtime.h>
 
@@ -95,6 +96,11 @@ __device__ __forceinline__ uint8_t f2e4m3(float x) {
   return static_cast<uint8_t>(__nv_cvt_float_to_fp8(fminf(fmaxf(x, -448.f), 448.f), __NV_SATFINITE, __NV_E4M3));
 }
 
+// float -> E2M1 code, round to nearest even after saturating to +-6 (torch .to(float4_e2m1fn_x2)).
+__device__ __forceinline__ uint8_t f2e2m1(float x) {
+  return static_cast<uint8_t>(__nv_cvt_float_to_fp4(fminf(fmaxf(x, -6.f), 6.f), __NV_E2M1, cudaRoundNearest));
+}
