+    cublas_check(cublasLtMatrixLayoutCreate(&la, CUDA_R_8F_E4M3, K, M, K), "layout a");
+    cublas_check(cublasLtMatrixLayoutCreate(&lc, CUDA_R_32F, N, M, ldc32), "layout c");
+
+    const auto key = std::make_tuple(M, N, K, ldw, K, ldc32, true, true);
+    auto it = impl_->algos.find(key);
+    if (it == impl_->algos.end()) {
