+    cublas_check(cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSA, &tw, sizeof(tw)), "transa");
+    cublas_check(cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSB, &ta, sizeof(ta)), "transb");
+    // per-tensor scaling, both scales 1: the per-row activation and weight scales are applied by the epilogue
