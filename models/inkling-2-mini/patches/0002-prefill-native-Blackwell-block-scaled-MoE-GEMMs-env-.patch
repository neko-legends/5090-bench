+      cublas_check(cublasLtMatmulPreferenceCreate(&pref), "preference create");
+      const std::size_t ws = kWorkspaceBytes;
+      const std::uint32_t reduction = CUBLASLT_REDUCTION_SCHEME_COMPUTE_TYPE;
+      cublasStatus_t st =
+          cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws, sizeof(ws));
+      if (st == CUBLAS_STATUS_SUCCESS)
+        st = cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_REDUCTION_SCHEME_MASK, &reduction,
+                                                  sizeof(reduction));
+      cublasLtMatmulHeuristicResult_t result{};
+      int found = 0;
+      if (st == CUBLAS_STATUS_SUCCESS)
+        st = cublasLtMatmulAlgoGetHeuristic(impl_->handle, op, lw, la, lc, lc, pref, 1, &result, &found);
+      cublasLtMatmulPreferenceDestroy(pref);
+      cublas_check(st, "heuristic");
+      if (found == 0) throw std::runtime_error("prefill Gemm fp8: no cuBLASLt algorithm (E4M3xE4M3 -> f32)");
+      it = impl_->algos.emplace(key, result.algo).first;
+    }
+    const float alpha = 1.f, beta = 0.f;
+    cublas_check(cublasLtMatmul(impl_->handle, op, &alpha, static_cast<const void*>(Wq), lw, impl_->aq, la, &beta,
+                                c32, lc, c32, lc, &it->second, impl_->workspace, kWorkspaceBytes, stream),
+                 "matmul fp8");
+  } catch (...) {
+    cleanup();
+    throw;
+  }
+  cleanup();
+  fp8_apply_scales(c32, ldc32, impl_->act_scale, w_scale, M, N, C, ldc, stream);
+}
+
 }  // namespace ingine::kernels::prefill
diff --git a/native/src/kernels/prefill/gemm_fp8.cu b/native/src/kernels/prefill/gemm_fp8.cu
new file mode 100644
index 0000000..b6d8c83
--- /dev/null
+++ b/native/src/kernels/prefill/gemm_fp8.cu
@@ -0,0 +1,80 @@
+// FP8 prefill projection kernels: per-row activation quantization to E4M3 and the row x column scale
+// epilogue of the cuBLASLt E4M3 x E4M3 GEMM (Gemm::run_fp8 in gemm.cpp).
+//   aq[m, k] = e4m3(A[m, k] * 448 / amax(m)), act_scale[m] = amax(m) / 448  (amax clamped at 1e-30)
+// so aq * act_scale == A exactly for every representable pair (torch clamp + .to(float8_e4m3fn) rounding).
+//   C[m, n] = bf16(c32[m, n] * act_scale[m] * w_scale[n])
+#include "kernels/prefill/common.cuh"
+#include "kernels/prefill/prefill.h"
+
+#include <stdexcept>
+#include <cstdint>
+
+namespace ingine::kernels::prefill {
+namespace {
+
+constexpr int kQuantThreads = 256;
+
+__global__ void __launch_bounds__(kQuantThreads) quant_rows_kernel(const __nv_bfloat16* __restrict__ a,
+                                                                   int lda, int k_elems, uint8_t* __restrict__ aq,
+                                                                   float* __restrict__ act_scale) {
+  const std::size_t m = blockIdx.x;
+  const __nv_bfloat16* row = a + m * std::size_t(lda);
+  float amax = 0.f;
+  for (int k = threadIdx.x; k < k_elems; k += kQuantThreads)
+    amax = fmaxf(amax, fabsf(__bfloat162float(row[k])));
+#pragma unroll
+  for (int off = 16; off > 0; off >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, off));
+  __shared__ float warp_max[kQuantThreads / 32];
+  const int warp = threadIdx.x >> 5;
+  if ((threadIdx.x & 31) == 0) warp_max[warp] = amax;
+  __syncthreads();
+  if (warp == 0) {
+    amax = (threadIdx.x < kQuantThreads / 32) ? warp_max[threadIdx.x] : 0.f;
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, off));
+    if (threadIdx.x == 0) {
+      const float clamped = fmaxf(amax, 1e-30f);
+      act_scale[m] = clamped * (1.f / 448.f);
+      warp_max[0] = 448.f / clamped;  // multiplier, published to the whole block
+    }
+  }
+  __syncthreads();
+  const float mul = warp_max[0];
+  uint8_t* out = aq + m * std::size_t(k_elems);
+  for (int k = threadIdx.x; k < k_elems; k += kQuantThreads)
+    out[k] = f2e4m3(__bfloat162float(row[k]) * mul);
+}
+
+constexpr int kScaleThreads = 256;
+
+__global__ void __launch_bounds__(kScaleThreads) apply_scales_kernel(const float* __restrict__ c32, int ldc32,
+                                                                     const float* __restrict__ act_scale,
+                                                                     const float* __restrict__ w_scale, int m_rows,
+                                                                     int n_cols, __nv_bfloat16* __restrict__ c,
+                                                                     int ldc) {
+  const int n = blockIdx.x * kScaleThreads + threadIdx.x;
+  if (n >= n_cols) return;
+  const float ws = __ldg(w_scale + n);
+  for (int m = blockIdx.y; m < m_rows; m += gridDim.y) {
+    const float v = __ldg(c32 + std::size_t(m) * ldc32 + n) * __ldg(act_scale + m) * ws;
+    c[std::size_t(m) * ldc + n] = __float2bfloat16_rn(v);
+  }
+}
+
+}  // namespace
+
+void fp8_quant_rows(const __nv_bfloat16* a, int lda, int m_rows, int k_elems, uint8_t* aq, float* act_scale,
+                    cudaStream_t stream) {
+  if (m_rows < 1 || k_elems < 1) throw std::invalid_argument("fp8_quant_rows: empty shape");
+  quant_rows_kernel<<<m_rows, kQuantThreads, 0, stream>>>(
+      a, lda, k_elems, aq, act_scale);
+}
+
+void fp8_apply_scales(const float* c32, int ldc32, const float* act_scale, const float* w_scale, int m_rows,
+                      int n_cols, __nv_bfloat16* c, int ldc, cudaStream_t stream) {
+  if (m_rows < 1 || n_cols < 1) throw std::invalid_argument("fp8_apply_scales: empty shape");
+  const dim3 grid((n_cols + kScaleThreads - 1) / kScaleThreads, std::min(m_rows, 65535));
+  apply_scales_kernel<<<grid, kScaleThreads, 0, stream>>>(c32, ldc32, act_scale, w_scale, m_rows, n_cols, c, ldc);
+}
+
+}  // namespace ingine::kernels::prefill
diff --git a/native/src/kernels/prefill/moe_quant.cu b/native/src/kernels/prefill/moe_quant.cu
new file mode 100644
index 0000000..1f3b5af
--- /dev/null
+++ b/native/src/kernels/prefill/moe_quant.cu
@@ -0,0 +1,92 @@
+// Dynamic block-scaled quantizers for the native Blackwell MoE grouped GEMM (wgemm.cu):
+//   nvfp4_quant_rows: x bf16 [rows, K] -> q e2m1 packed nibbles [rows, K/2] (byte c = elements 2c lo,
+//     2c+1 hi) + s ue4m3 [rows, K/16]; value = e2m1(q) * ue4m3(s), s = amax/6 rounded to ue4m3.
+//   mxfp8_quant_rows: x bf16 [rows, K] -> q e4m3 [rows, K] + s ue8m0 [rows, K/32]; scale is a power of
+//     two >= amax/448, value = e4m3(q) * 2^(s-127) (MXFP8: 32-element power-of-two blocks).
+// Both quantize each row's blocks independently; identical rounding on every element of a block.
+#include "kernels/prefill/common.cuh"
+#include "kernels/prefill/prefill.h"
+
+#include <stdexcept>
+#include <cstdint>
+
+namespace ingine::kernels::prefill {
+namespace {
+
+constexpr int kQThreads = 256;
+
+// ---- NVFP4: one block per row, 16-element blocks, thread t handles blocks t, t + 256, ...
+__global__ void __launch_bounds__(kQThreads) nvfp4_quant_kernel(const __nv_bfloat16* __restrict__ x, int k_elems,
+                                                                 unsigned char* __restrict__ q,
+                                                                 unsigned char* __restrict__ s) {
+  const std::size_t row = blockIdx.x;
+  const __nv_bfloat16* xr = x + row * std::size_t(k_elems);
+  unsigned char* qr = q + row * std::size_t(k_elems / 2);
+  unsigned char* sr = s + row * std::size_t(k_elems / 16);
+  for (int b = threadIdx.x; b < k_elems / 16; b += kQThreads) {
+    float v[16];
+    float amax = 0.f;
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+      v[j] = __bfloat162float(xr[b * 16 + j]);
+      amax = fmaxf(amax, fabsf(v[j]));
+    }
+    // scale = amax/6 rounded to ue4m3; quantize against the rounded scale, saturating at +-6
+    const unsigned char s8 = f2e4m3(amax * (1.f / 6.f));
+    const float2 sf = e4m3x2_to_float2(uint16_t(s8));  // s8 is nonnegative: exact in the low half
+    const float scale = sf.x;
+    const float inv = scale > 0.f ? 1.f / scale : 0.f;
+    unsigned char codes[8] = {};
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+      const float w = fminf(fmaxf(v[j] * inv, -6.f), 6.f);
+      codes[j >> 1] |= static_cast<unsigned char>(f2e2m1(w) << ((j & 1) * 4));
+    }
+    sr[b] = s8;
+#pragma unroll
+    for (int c = 0; c < 8; ++c) qr[b * 8 + c] = codes[c];
+  }
+}
+
+// ---- MXFP8: one block per row, 32-element blocks
+__global__ void __launch_bounds__(kQThreads) mxfp8_quant_kernel(const __nv_bfloat16* __restrict__ x, int k_elems,
+                                                                 unsigned char* __restrict__ q,
+                                                                 unsigned char* __restrict__ s) {
+  const std::size_t row = blockIdx.x;
+  const __nv_bfloat16* xr = x + row * std::size_t(k_elems);
+  unsigned char* qr = q + row * std::size_t(k_elems);
+  unsigned char* sr = s + row * std::size_t(k_elems / 32);
+  for (int b = threadIdx.x; b < k_elems / 32; b += kQThreads) {
+    float amax = 0.f;
+    for (int j = 0; j < 32; ++j) amax = fmaxf(amax, fabsf(__bfloat162float(xr[b * 32 + j])));
+    // smallest power of two >= amax/448; e4m3 max 448
+    int e = 0;
+    if (amax > 0.f) {
+      const float need = amax * (1.f / 448.f);
+      e = max(0, (int)ceilf(log2f(need)));
+      e = min(e, 127);
+    }
+    const float scale = exp2f(float(e));
+    const float inv = scale > 0.f ? 1.f / scale : 0.f;
+    sr[b] = static_cast<unsigned char>(e + 127);
+    for (int j = 0; j < 32; ++j) qr[b * 32 + j] = f2e4m3(__bfloat162float(xr[b * 32 + j]) * inv);
+  }
+}
+
+}  // namespace
+
+void nvfp4_quant_rows(const __nv_bfloat16* x, int rows, int k_elems, unsigned char* q, unsigned char* s,
+                      cudaStream_t stream) {
+  if (rows < 1 || k_elems < 16 || k_elems % 16 != 0)
+    throw std::invalid_argument("nvfp4_quant_rows: K must be a positive multiple of 16");
+  nvfp4_quant_kernel<<<rows, kQThreads, 0, stream>>>(x, k_elems, q, s);
+}
+
+void mxfp8_quant_rows(const __nv_bfloat16* x, int rows, int k_elems, unsigned char* q, unsigned char* s,
+                      cudaStream_t stream) {
+  if (rows < 1 || k_elems < 32 || k_elems % 32 != 0)
+    throw std::invalid_argument("mxfp8_quant_rows: K must be a positive multiple of 32");
+  mxfp8_quant_kernel<<<rows, kQThreads, 0, stream>>>(x, k_elems, q, s);
+}
+
+}  // namespace ingine::kernels::prefill
diff --git a/native/src/kernels/prefill/wgemm.cu b/native/src/kernels/prefill/wgemm.cu
index 52d90c1..8bd37fc 100644
--- a/native/src/kernels/prefill/wgemm.cu
+++ b/native/src/kernels/prefill/wgemm.cu
@@ -1,20 +1,25 @@
-// Grouped expert GEMMs of the prefill (model._moe_grouped) over NVFP4 / MXFP8 experts decoded on the fly.
+// Grouped expert GEMMs of the prefill (model._moe_grouped) over NVFP4 / MXFP8 experts.
 //
-// Design. A CTA computes up to 128 activation rows x 128 weight rows, K in steps of 64, mma.m16n8k16 BF16 with
-// FP32 accumulation. The 8 warps split the weight rows (16 each) and every warp covers all of the tile's
-// activation rows, so each weight element is decoded exactly once per CTA, straight from the staged checkpoint
-// codes into the MMA B fragments in registers (no BF16 weight tile in shared memory):
