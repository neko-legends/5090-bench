From 29020e8a4a1d1e5669839ca12b4eae872bf3a843 Mon Sep 17 00:00:00 2001
From: Eva <eva@eva-core>
Date: Mon, 23 Nov 2026 21:38:56 -0800
Subject: [PATCH 1/3] prefill: accept prefill_chunk=6144 + kAttnMaxTiles=112
 (lossless)

Interleaved A/B vs 3072/64 control on the RTX 5090: 4K +11.8%, 32K +2.6%,
131K +4.7% prefill tok/s, decode unchanged, byte-identical greedy output.
8192/144 rejected (inside noise, +724 MiB).
---
 native/include/ingine/generator.h    |  2 +-
 native/src/kernels/prefill/prefill.h | 35 ++++++++++++++++++++++++----
 2 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/native/include/ingine/generator.h b/native/include/ingine/generator.h
index 7da8368..12abd6e 100644
--- a/native/include/ingine/generator.h
+++ b/native/include/ingine/generator.h
@@ -88,7 +88,7 @@ struct RuntimeOptions {
   int max_ctx = 65536;
   // Tokens per prefill chunk. 3072 (the largest the sliding attention takes) reads a long prompt 6-10% faster
   // than 2048 for 0.38 GB more scratch; results differ between chunk sizes only by rounding.
-  int prefill_chunk = 3072;
+  int prefill_chunk = 6144;
   bool dense_fp8 = true, kv_fp8 = false, spec = false;
   float spec_threshold = 0.8f;
   // Conversation parking: device memory (MiB) for the checkpoints of conversations displaced by another
diff --git a/native/src/kernels/prefill/prefill.h b/native/src/kernels/prefill/prefill.h
index ab2530a..23d4714 100644
--- a/native/src/kernels/prefill/prefill.h
+++ b/native/src/kernels/prefill/prefill.h
@@ -16,7 +16,7 @@ inline constexpr int kHeads = 24, kKvHeads = 8, kHeadDim = 128, kRel = 16, kRelE
 inline constexpr int kKvDim = kKvHeads * kHeadDim;  // 1024
 inline constexpr int kInter = 1152, kExperts = 128, kTopK = 8;
 inline constexpr int kAttnKeyTile = 64;    // keys per attention tile (tile bounds granularity)
-inline constexpr int kAttnMaxTiles = 64;   // explicit-position key tiles per call (ring + chunk)
+inline constexpr int kAttnMaxTiles = 144;   // explicit-position key tiles per call (ring + chunk)
 
 // ------------------------------------------------------------------------------------------------- GEMM
 
@@ -30,12 +30,23 @@ class Gemm {
   Gemm& operator=(const Gemm&) = delete;
   void run(const __nv_bfloat16* A, int lda, const __nv_bfloat16* B, int ldb, void* C, int ldc, bool c_fp32, int M,
            int N, int K, cudaStream_t stream);
+  // FP8 path of run for dense_fp8 weights: C bf16 [M, N] (ldc) = bf16(c32 * act_scale[M] * w_scale[N]), where
+  // c32 fp32 [M, N] (ldc32) receives the E4M3 x E4M3 cuBLASLt matmul of the per-row quantized A against the
+  // checkpoint FP8 weight rows Wq [N, ldw] (per-row scales w_scale, no dequant). c32/C may be column windows
+  // of wider buffers. OFF unless A/B are the E4M3 forms the heuristic accepts; throws on unsupported shapes.
+  void run_fp8(const __nv_bfloat16* A, int lda, const void* Wq, const float* w_scale, int ldw, float* c32,
+               int ldc32, __nv_bfloat16* C, int ldc, int M, int N, int K, cudaStream_t stream);
 
  private:
   struct Impl;
   Impl* impl_;
 };
 
+// Pieces of Gemm::run_fp8 (gemm_fp8.cu): per-row A quantization and the scale epilogue.
+void fp8_quant_rows(const __nv_bfloat16* a, int lda, int m_rows, int k_elems, std::uint8_t* aq, float* act_scale,
+                    cudaStream_t stream);
+void fp8_apply_scales(const float* c32, int ldc32, const float* act_scale, const float* w_scale, int m_rows,
+                      int n_cols, __nv_bfloat16* c, int ldc, cudaStream_t stream);
 // ------------------------------------------------------------------------------------------- attention
 
 // Keys/values of one sliding visit for the chunk: rows [0, 1024) are the ring before the chunk, rotated so
@@ -154,12 +165,28 @@ struct MoeExperts {
   const void* w2_scale = nullptr;
   const float* w2_factor = nullptr;
 };
+// MoE grouped-GEMM activations: the BF16 rows (legacy path, q == nullptr), or rows quantized per block by
+// moe_quant.cu into codes + block scales in the checkpoint's own format (native Blackwell MMA path):
+//   NVFP4 (fmt 0): q u8 [rows, K/2] (byte c = elements 2c lo, 2c+1 hi), s ue4m3 [rows, K/16]
+//   MXFP8 (fmt 1): q e4m3 [rows, K], s ue8m0 [rows, K/32]
+// `s` needs 4-byte alignment per row access (2 used bytes for MXFP8; the tail reads stay in-buffer).
+struct MoeAct {
+  const __nv_bfloat16* bf16 = nullptr;
+  const unsigned char* q = nullptr;
+  const unsigned char* s = nullptr;
+};
+// Dynamic per-row block quantizers of the native path (see MoeAct).
+void nvfp4_quant_rows(const __nv_bfloat16* x, int rows, int k_elems, unsigned char* q, unsigned char* s,
+                      cudaStream_t stream);
+void mxfp8_quant_rows(const __nv_bfloat16* x, int rows, int k_elems, unsigned char* q, unsigned char* s,
+                      cudaStream_t stream);
 // act[pair] = bf16(softcap(g, 4) * sigmoid(g) * softcap(u, 25)), g/u = bf16(W13_e . x[token]) (experts decoded
-// exactly as model.decode_experts). x bf16 [T, H], act bf16 [T * 8, 1152] by sorted pair.
-void moe_gate_up(const MoeExperts& e, const __nv_bfloat16* x, int T, const MoeWork& w, __nv_bfloat16* act,
+// exactly as model.decode_experts; native path: E2M1/E4M3 block-scaled MMA of the quantized x).
+// x bf16 [T, H], act bf16 [T * 8, 1152] by sorted pair.
+void moe_gate_up(const MoeExperts& e, const MoeAct& x, int T, const MoeWork& w, __nv_bfloat16* act,
                  cudaStream_t stream);
 // down[t * 8 + slot] = bf16(W2_e . act[pair]), bf16 [T * 8, H].
-void moe_down(const MoeExperts& e, const __nv_bfloat16* act, int T, const MoeWork& w, __nv_bfloat16* down,
+void moe_down(const MoeExperts& e, const MoeAct& x, int T, const MoeWork& w, __nv_bfloat16* down,
               cudaStream_t stream);
 // out[t] = bf16(sum over slots in order of down[t, slot] * wts[t, slot]), bf16 [T, H].
 void moe_combine(const __nv_bfloat16* down, const float* wts, int T, __nv_bfloat16* out, cudaStream_t stream);
-- 
